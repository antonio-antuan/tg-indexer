# Copy to .env (gitignored, chmod 600) and replace every placeholder.
# Never commit real values.

# Postgres (docker compose). Use a long random value of letters and digits only
# (the Makefile and compose both read this file). Deliberately empty: compose refuses to
# start until it is set.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://tgi:${POSTGRES_PASSWORD}@127.0.0.1:5432/tgi

# Outside the repo; DATA_DIR/accounts holds TDLib sessions (full account access, mode 0700).
DATA_DIR=/path/outside/repo/tgi-data
TDLIB_DB_KEY=change-me
TG_API_ID=change-me
TG_API_HASH=change-me
# libtdjson from scripts/tdlib.sh; empty means DATA_DIR/lib/libtdjson.so.
TDJSON_PATH=

# Sync
BACKFILL_YEARS=3
SWEEP_DAYS=7
PAGE_DELAY_MS=300
ON_DELETE=tombstone

# Windows
WINDOW_GAP_MIN=30
WINDOW_MAX_CHARS=1500
WINDOW_MAX_MSGS=40

# Embeddings: openai (the default), voyage or fake (tests only: not semantic). EMBED_MODEL
# defaults per provider (text-embedding-3-small, voyage-4). The selected provider's key is
# required: left empty, `tgi` stops with "OPENAI_API_KEY is not set" (exit 1). When the host
# routes the provider's API through a proxy that injects the real key (e.g. OneCLI), set any
# non-empty placeholder such as `placeholder` here and keep the real key out of this file;
# otherwise the real key goes here (this file is mode 0600, never committed). Changing the
# provider or model later means `tgi embed --reindex` (every window embedded again, paid).
EMBED_PROVIDER=openai
EMBED_MODEL=
OPENAI_API_KEY=
# Only for EMBED_PROVIDER=voyage.
VOYAGE_API_KEY=

# MCP server (P2). Loopback by default; the Docker-network gateway address is set at registration.
MCP_BIND=127.0.0.1:8765
# Required by `tgi mcp --http`: generate one with `tgi mcp token` (32 random bytes). The
# same value is given to the Nano agent at registration; it is never logged or committed.
MCP_TOKEN=
# Host names a client may use besides the MCP_BIND address (comma-separated, no port), for
# the DNS-rebinding check; host.docker.internal is accepted on a Docker-network bind already.
MCP_ALLOWED_HOSTS=
# The account the MCP `add_chat` tool joins chats with; empty means the only logged-in one.
MCP_ACCOUNT=
# 1 (true/yes/on) serves only the read tools: suggest_tags and add_chat are not offered and the
# server never opens Telegram (add chats with `tgi chats add`). Empty or 0: all nine tools.
MCP_READ_ONLY=
# Minutes between scheduled `tgi sync` runs (a timer on the host, aligned to the hour for
# 60); `add_chat` uses it to say when a new chat becomes searchable. Empty or 0: no schedule; at most 10080.
SYNC_EVERY_MINUTES=
# `tgi sync`'s time budget in minutes when --max-minutes is not given (the shipped service
# gives none), and the run length add_chat's estimates assume. Empty: 150; 1 to 10080.
SYNC_MAX_MINUTES=
