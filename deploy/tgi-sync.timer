# Every 3 hours on the UTC clock (SPEC §5.3; UTC, so `tgi status` and add_chat's estimates from
# SYNC_EVERY_MINUTES line up), and at the next start when a run was missed (Persistent). For
# fresher answers run it more often with a smaller budget, e.g. hourly with
# `--max-minutes 50` in tgi-sync.service; set SYNC_EVERY_MINUTES to match (add_chat's estimates).

[Unit]
Description=tg-indexer sync every 3 hours

[Timer]
OnCalendar=*-*-* 00/3:00:00 UTC
Persistent=true

[Install]
WantedBy=timers.target
