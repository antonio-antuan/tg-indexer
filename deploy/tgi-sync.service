# tgi sync as a systemd user service, started by tgi-sync.timer (SPEC §5.3). A template: it
# assumes the checkout at ~/tg-indexer with `uv sync` done, and the settings in
# ~/.config/tgi/.env (mode 0600). systemd does not expand ${…} or ~ in that file: write
# DATABASE_URL with the password itself and absolute paths.
#   install -Dm644 deploy/tgi-sync.service ~/.config/systemd/user/tgi-sync.service
#   install -Dm644 deploy/tgi-sync.timer ~/.config/systemd/user/tgi-sync.timer
#   systemctl --user daemon-reload && systemctl --user enable --now tgi-sync.timer
# and set SYNC_EVERY_MINUTES=180 in that .env (60 for an hourly timer): `tgi status` and
# add_chat read it to tell when the next run is; restart `tgi mcp` to pick it up.
# Exit 2 (another sync, embed, purge or forget holds the lock) is a skipped run, not a failure.

[Unit]
Description=tg-indexer sync (tgi sync)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/tg-indexer
EnvironmentFile=%h/.config/tgi/.env
# The budget is SYNC_MAX_MINUTES (default 150), which add_chat's estimates read too. It is soft
# (the window and embed steps finish their batch): stop well after it, and raise this timeout
# if you raise the budget.
ExecStart=%h/tg-indexer/.venv/bin/tgi sync
TimeoutStartSec=170min
SuccessExitStatus=2
NoNewPrivileges=yes
